# DokVol — Environment Configuration
#
# Place this file at:
#   - /etc/dokvol/.env    (when installed via install.sh / Docker)
#   - .env                (when running locally with `go run`)
#   - or set DOKVOL_ENV   (custom path via environment variable)

# HTTP server listen address
LISTEN_ADDR=:8080

# SQLite database path
# In production (Docker), keep this under /etc/dokvol (persistent bind mount) —
# anything under the container's own WORKDIR is lost on `docker rm`/update.
# ./dokvol.db is fine for local `go run` dev only.
DOKVOL_DB_PATH=./dokvol.db

# Admin credentials (optional — if unset, random credentials are generated
# on first startup and printed in the logs)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# JWT secret key (change in production!)
# If not set, a hardcoded dev default is used
JWT_SECRET=change-me-to-a-long-random-string

# JWT token expiry durations
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
